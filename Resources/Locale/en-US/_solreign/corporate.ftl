# "The Corporate Ladder" — evil-megacorp HR voice. Cosmetic flavor only; nothing here compels play.

# PA sender label stamped on every Corporate Ladder broadcast.
solreign-corporate-hr-sender = Solreign HR

# Fired over the PA when the round begins (SolreignCorporateRuleSystem.Started).
solreign-corporate-keynote =
    Good morning, Assets, and welcome to Solreign. Today we redefine synergy. Effective immediately,
    your continued respiration is being tracked against a bold new metric: Corporate Standing.
    Outperform your colleagues. Insource their responsibilities. Remember — there is no "I" in
    "shareholder value", but there is a "U", and it is being watched. Let's make this quarter unforgettable.

# The "quarterly earnings call" scoreboard. { $board } is the pre-rendered top-N body.
solreign-corporate-earnings-call =
    Solreign Quarterly Earnings Call. Please hold your applause and your grievances. Top performers,
    this fiscal quarter:
    { $board }
    Everyone else: a growth opportunity has been added to your permanent record.

# Round-end "FY final standings" block header.
solreign-corporate-fy-header = === Solreign FY Final Standings ===

# Shown at round end when nobody accrued any Corporate Standing.
solreign-corporate-fy-empty = No measurable value was created this fiscal year. The Board is disappointed but unsurprised.
