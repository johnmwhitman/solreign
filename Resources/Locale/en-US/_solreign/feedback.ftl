# Structured player feedback window (roadmap D2.1 -- replaces the old console-only "bugreport")

cmd-feedback-help = Usage: feedback — opens the structured feedback window (bug / idea / balance / fun / confusion).

# Escape/game menu button (roadmap D2.1 HUD button stretch goal) -- opens the same window as the
# "feedback" console command. Named distinctly from vanilla's own "ui-escape-feedback" button
# (Content.Client.FeedbackPopup), which is an unrelated upstream survey popup.
ui-escape-solreign-feedback = Solreign Feedback

feedback-window-title = Feedback
feedback-window-intro = Tell Solreign what's on your mind. This goes straight into our feedback log with safe context (round, map, job, build) — never your chat.
feedback-window-category-label = Category:
feedback-category-bug = Bug
feedback-category-idea = Idea
feedback-category-balance = Balance
feedback-category-fun = Fun
feedback-category-confusion = Confusion
feedback-window-text-placeholder = Describe what happened, what you'd like to see, or what confused you...
feedback-window-length = {$length} / {$max}
feedback-window-submit = Submit
feedback-window-sending = Sending...
feedback-window-success = Filed! Your reference is {$reference}.
feedback-window-unknown-error = Something went wrong sending your feedback. Please try again.

feedback-window-safety-heading = Reporting conduct or a safety concern?
feedback-window-safety-body = Use this instead — it goes straight to staff, stays confidential, and is handled with urgency. Feedback above is for the game itself, not for reporting people.
feedback-window-safety-button = Open ahelp

feedback-empty = Please write something before submitting.
feedback-rate-limited = You've reached the feedback limit for this round ({$max} submissions). Thanks for the reports — try again next round.
