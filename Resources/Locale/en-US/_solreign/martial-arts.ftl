# Solreign "Way of the Ornamental Carp" — acid-green corporate HR voice.
# The scroll teaches once; each combo finisher gets one loud popup.

# Scroll used successfully: the lesson takes, the scroll crumbles.
solreign-carp-scroll-learned = { $user } absorbs the Way of the Ornamental Carp. Enrichment complete. The scroll self-files.

# Scroll used by someone already certified: refused, not consumed.
solreign-carp-scroll-already = You have already completed Ornamental Carp certification. Refresher courses are not offered.

# Carp Rush (hit, hit): battle cry above the artist...
solreign-carp-rush-cry = { $user } bellows "CARP RUSH!" with full corporate sincerity!

# ...and the outcome above the target (stamina jolt only).
solreign-carp-rush-target = { $target } receives two rapid coaching sessions, back to back.

# Rising Tide (hit, shove): knockdown.
solreign-rising-tide = { $target } is escorted to the floor by the Rising Tide. Please remain seated.

# Gentle Current (shove, shove): the held item flies.
solreign-gentle-current = The Gentle Current relieves { $target } of { THE($item) }. Equipment is now in transit.

# Gentle Current with nothing left to take: the form still counts.
solreign-gentle-current-empty = The Gentle Current finds { $target } already empty-handed. Exemplary compliance. Noted.
