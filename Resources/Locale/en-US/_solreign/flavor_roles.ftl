## Salvaged flavor roles: Smuggler / Courier / Scavenger
## (Musician locale already ships upstream.)

job-name-smuggler = Smuggler
job-description-smuggler = Move contraband through the station's blind spots and keep the manifest honest-looking.

job-name-courier = Courier
job-description-courier = Ferry parcels and paperwork wherever they need to go, fast and no questions asked.

job-name-scavenger = Scavenger
job-description-scavenger = Pick the wrecks and asteroids clean and drag the salvage home.

guide-entry-courier = Courier
guide-entry-courier-text = The Courier hauls parcels across the station. Grab your bag, keep moving, and mind the airlocks.

guide-entry-scavenger = Scavenger
guide-entry-scavenger-text = The Scavenger works the wrecks beyond the station. Bring a crowbar, watch your oxygen, and haul back anything worth credits.
