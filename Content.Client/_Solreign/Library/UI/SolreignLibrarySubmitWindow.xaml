<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'solreign-library-window-title'}"
                      SetSize="480 460"
                      MinSize="380 340">
    <!-- Plain title+body submission form — the SolreignNoticeboardWindow single-input idiom,
         extended to two fields since a book needs a title. No list rendering here: reading an
         already-materialized work reuses the existing Paper BUI on the book item itself. -->
    <BoxContainer Orientation="Vertical"
                  Margin="10"
                  SeparationOverride="6"
                  VerticalExpand="True">
        <Label Text="{Loc 'solreign-library-window-title-label'}" />
        <LineEdit Name="TitleInput" HorizontalExpand="True" />
        <Label Text="{Loc 'solreign-library-window-body-label'}" />
        <PanelContainer VerticalExpand="True" HorizontalExpand="True" MinSize="0 220">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1B1B1E" />
            </PanelContainer.PanelOverride>
            <ScrollContainer HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True">
                <TextEdit Name="BodyInput" HorizontalExpand="True" VerticalExpand="True" />
            </ScrollContainer>
        </PanelContainer>
        <BoxContainer Orientation="Horizontal">
            <Label Name="CharCountLabel" HorizontalExpand="True" />
            <Button Name="SubmitButton" Text="{Loc 'solreign-library-ui-submit-button'}" />
        </BoxContainer>
        <!-- Footer -->
        <BoxContainer Orientation="Vertical">
            <PanelContainer StyleClasses="LowDivider" />
            <BoxContainer Orientation="Horizontal" Margin="10 2 5 0" VerticalAlignment="Bottom">
                <Label Text="{Loc 'solreign-library-window-hint'}" StyleClasses="WindowFooterText" />
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
