<controls:FancyWindow xmlns="https://spacestation14.io"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                       Title="Solreign Corporate Projects"
                       SetSize="720, 520">
    <BoxContainer Orientation="Vertical" Margin="8">
        <Label Text="ACTIVE CORPORATE R&amp;D INITIATIVES" StyleClasses="LabelHeading" HorizontalAlignment="Center" Margin="0,0,0,8"/>
        
        <BoxContainer Orientation="Horizontal" VerticalExpand="True" HorizontalExpand="True">
            <!-- Left Panel: Project List -->
            <BoxContainer Orientation="Vertical" MinWidth="220" Margin="0,0,8,0">
                <Label Text="Projects" StyleClasses="LabelSubheading" Margin="0,0,0,4"/>
                <ScrollContainer VerticalExpand="True">
                    <BoxContainer Name="ProjectListContainer" Orientation="Vertical" />
                </ScrollContainer>
            </BoxContainer>
            
            <!-- Right Panel: Project Details & Contribution -->
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
                <Label Name="ProjectNameLabel" Text="Select a Project" StyleClasses="LabelHeading" Margin="0,0,0,4"/>
                <Label Name="SponsorLabel" Text="" StyleClasses="LabelSubheading" Margin="0,0,0,4"/>
                <RichTextLabel Name="DescriptionLabel" Margin="0,0,0,8"/>
                
                <ProgressBar Name="OverallProgressBar" MinHeight="20" Margin="0,0,0,4"/>
                <Label Name="ProgressLabel" Text="" Margin="0,0,0,4"/>
                <Label Name="AccountShareLabel" Text="" Margin="0,0,0,8"/>
                
                <Label Text="Milestone Unlocks" StyleClasses="LabelSubheading" Margin="0,4,0,4"/>
                <ScrollContainer VerticalExpand="True" MinHeight="120">
                    <BoxContainer Name="MilestonesContainer" Orientation="Vertical" />
                </ScrollContainer>
                
                <BoxContainer Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
                    <LineEdit Name="AmountInput" PlaceHolder="Amount" MinWidth="100" Margin="0,0,8,0"/>
                    <Button Name="ContributeButton" Text="Contribute Funding" />
                </BoxContainer>
                
                <Label Name="StatusLabel" Text="" Margin="0,4,0,0" HorizontalAlignment="Center"/>
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
