<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'solreign-afterlife-window-title'}"
               MinSize="450 300" SetSize="450 400">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True">
        <Label Name="IntroLabel" Text="{Loc 'solreign-afterlife-window-intro'}" HorizontalAlignment="Center" Margin="0 4" />
        <Label Name="EmptyLabel" Text="{Loc 'solreign-afterlife-window-empty'}" HorizontalAlignment="Center" Margin="0 8" Visible="False" />
        <ScrollContainer Name="ActivityScroll" VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="ActivityContainer" Orientation="Vertical" VerticalExpand="True" SeparationOverride="8">
                <!-- Activity entries get added here by code -->
            </BoxContainer>
        </ScrollContainer>
    </BoxContainer>
</DefaultWindow>
