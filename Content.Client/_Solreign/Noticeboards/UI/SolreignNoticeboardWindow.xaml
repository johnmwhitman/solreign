<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'solreign-noticeboards-window-title'}"
                      SetSize="560 480"
                      MinSize="420 360">
    <!-- Layout copies the Liability Board window (scrolling list over a footer) with the same
         single-input idiom bolted on below the list: one post box for the whole board, notes
         render as a list of rows each with their own Report button. -->
    <BoxContainer Orientation="Vertical"
                  Margin="10"
                  SeparationOverride="6"
                  VerticalExpand="True">
        <PanelContainer VerticalExpand="True" HorizontalExpand="True">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1B1B1E" />
            </PanelContainer.PanelOverride>
            <ScrollContainer HScrollEnabled="False"
                             HorizontalExpand="True"
                             VerticalExpand="True">
                <Label Name="NoNotesLabel"
                       Text="{Loc 'solreign-noticeboards-window-empty'}"
                       Visible="False"
                       Align="Center" />
                <!-- A failed local read shows THIS line, never the true-empty copy above — same
                     ALIVENESS discipline as the Liability Board's offline state. -->
                <Label Name="OfflineLabel"
                       Text="{Loc 'solreign-noticeboards-window-offline'}"
                       Visible="False"
                       Align="Center" />
                <BoxContainer Name="NoteEntriesContainer"
                              Orientation="Vertical"
                              VerticalExpand="True"
                              HorizontalExpand="True" />
            </ScrollContainer>
        </PanelContainer>
        <Label Name="StatusLabel"
               Visible="False"
               Align="Center" />
        <PanelContainer StyleClasses="LowDivider" />
        <LineEdit Name="PostInput" HorizontalExpand="True" />
        <BoxContainer Orientation="Horizontal">
            <Label Name="CharCountLabel" HorizontalExpand="True" />
            <Button Name="SubmitButton" Text="{Loc 'solreign-noticeboards-ui-submit-button'}" />
        </BoxContainer>
        <!-- Footer -->
        <BoxContainer Orientation="Vertical">
            <PanelContainer StyleClasses="LowDivider" />
            <BoxContainer Orientation="Horizontal" Margin="10 2 5 0" VerticalAlignment="Bottom">
                <Label Text="{Loc 'solreign-noticeboards-window-hint'}" StyleClasses="WindowFooterText" />
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
