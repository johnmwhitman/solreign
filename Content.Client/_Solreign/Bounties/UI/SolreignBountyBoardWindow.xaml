<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'solreign-bounties-window-title'}"
                      SetSize="560 480"
                      MinSize="420 360">
    <!-- Layout copies the Contracts Board window (scrolling list over a footer) with the
         Directive Terminal's single-input idiom bolted on below the list: the claim API takes
         no bounty id, so there is ONE claim box for the whole board, not a per-row button. -->
    <BoxContainer Orientation="Vertical"
                  Margin="10"
                  SeparationOverride="6"
                  VerticalExpand="True">
        <PanelContainer VerticalExpand="True" HorizontalExpand="True">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1B1B1E" />
            </PanelContainer.PanelOverride>
            <ScrollContainer HScrollEnabled="False"
                             HorizontalExpand="True"
                             VerticalExpand="True">
                <Label Name="NoBountiesLabel"
                       Text="{Loc 'solreign-bounties-window-empty'}"
                       Visible="False"
                       Align="Center" />
                <!-- ALIVENESS P0 #2: a failed daemon fetch shows THIS line, never the true-empty
                     copy above — the two states must never be identical (market.ftl's "dealer is
                     not answering" idiom). -->
                <Label Name="OfflineLabel"
                       Text="{Loc 'solreign-bounties-window-offline'}"
                       Visible="False"
                       Align="Center" />
                <BoxContainer Name="BountyEntriesContainer"
                              Orientation="Vertical"
                              VerticalExpand="True"
                              HorizontalExpand="True" />
            </ScrollContainer>
        </PanelContainer>
        <Label Name="StatusLabel"
               Visible="False"
               Align="Center" />
        <PanelContainer StyleClasses="LowDivider" />
        <LineEdit Name="ClaimInput" HorizontalExpand="True" />
        <BoxContainer Orientation="Horizontal">
            <Label Name="CharCountLabel" HorizontalExpand="True" />
            <Button Name="SubmitButton" Text="{Loc 'solreign-bounties-ui-submit-button'}" />
        </BoxContainer>
        <!-- Footer -->
        <BoxContainer Orientation="Vertical">
            <PanelContainer StyleClasses="LowDivider" />
            <BoxContainer Orientation="Horizontal" Margin="10 2 5 0" VerticalAlignment="Bottom">
                <Label Text="{Loc 'solreign-bounties-window-hint'}" StyleClasses="WindowFooterText" />
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
